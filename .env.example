# Groq API (OpenAI-compatible client)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# PostgreSQL (used in a later step; stub uses in-memory store for now)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doc_pipeline

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://172.17.19.162:3000,http://172.17.19.162:3001

# Frontend (Next.js) — browser + SSR. On Vercel set both of these to your Render URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
